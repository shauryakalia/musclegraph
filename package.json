{
  "name": "muscle-graph",
  "version": "1.0.0",
  "private": true,
  "description": "Strength-training reference: muscle map, exercise demos and side-by-side comparisons. Data lives in CSV files under data/.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx scripts/build-public-data.ts && next dev",
    "build": "tsx scripts/build-public-data.ts && next build",
    "preview": "serve out",
    "data:build": "tsx scripts/build-public-data.ts",
    "check-data": "tsx scripts/check-data.ts",
    "ms:scrape": "tsx scripts/ms-scrape.ts",
    "ms:build": "tsx scripts/ms-build.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check-data && pnpm typecheck && pnpm build && node scripts/verify-out.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "serve": "^14.2.6",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "sharp"
    ]
  }
}
